# Copy to .env (git-ignored) and fill in. Both are optional: without them the
# committed data in data/raw/ is used for that source.

# NEAR Intents Explorer API JWT - from https://partners.near-intents.org
NEAR_INTENTS_JWT=

# BigQuery service account (role: BigQuery Job User). Use ONE of:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
#   GCP_SA_KEY_B64=<base64 of the key JSON, one line>
GOOGLE_APPLICATION_CREDENTIALS=
# Refuse any single query that would scan more than this many GB (free tier: 1 TB/month)
BQ_MAX_GB=150
